<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GrundsteuerPortal.Web</RootNamespace>
    <UserSecretsId>grundsteuerportal-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.7.0" />
    <!-- Pin auf die gepatchte SQLitePCLRaw-Kette: die von EF Core mitgebrachte Version 2.1.11
         hat eine bekannte Schwachstelle (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrundsteuerPortal.Core\GrundsteuerPortal.Core.csproj" />
    <ProjectReference Include="..\GrundsteuerPortal.Persistence\GrundsteuerPortal.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development-Konfiguration darf nie ins Publish/Image. Die .dockerignore schliesst sie
         bereits aus dem Build-Kontext aus; diese Regel greift zusaetzlich bei jedem publish,
         unabhaengig davon, wer das Dockerfile oder die .dockerignore spaeter aendert.
         Nur das Publish ist betroffen - 'dotnet run' in der Entwicklung nutzt weiterhin die Datei. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
