@page "/not-found"
@layout GrundsteuerPortal.Web.Components.Layout.MainLayout

<PageTitle>Nicht gefunden – GrundsteuerPortal</PageTitle>

<MudPaper Class="pa-8" Elevation="0">
    <MudText Typo="Typo.h4" GutterBottom="true">Seite nicht gefunden</MudText>
    <MudText Typo="Typo.body1">
        Die aufgerufene Adresse existiert in diesem Portal nicht.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
               StartIcon="@Icons.Material.Filled.Home">Zur Übersicht</MudButton>
</MudPaper>
