@page "/error"

<PageTitle>Fehler – GrundsteuerPortal</PageTitle>

<MudPaper Class="pa-8" Elevation="0">
    <MudText Typo="Typo.h4" GutterBottom="true">Es ist ein Fehler aufgetreten</MudText>
    <MudText Typo="Typo.body1">
        Der Vorgang konnte nicht abgeschlossen werden. Bitte die Seite neu laden und den Vorgang
        erneut versuchen. Gespeicherte Entwürfe bleiben erhalten.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
               StartIcon="@Icons.Material.Filled.Home">Zur Übersicht</MudButton>
</MudPaper>
